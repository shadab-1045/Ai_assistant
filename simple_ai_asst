import json
from types import SimpleNamespace
from dotenv import load_dotenv
import os
from openai import OpenAI

from tools import TOOLS, run_tool
from Utilities.utilities import log
load_dotenv()

client = OpenAI(
    base_url=os.getenv("BASE_URL"),
    api_key=os.getenv("API_KEY")
)
messages=[]
messages.append({"role": "system", "content": "You are a helpful assistant."})


def stream_chat(history):
    stream = client.chat.completions.create(
        model=os.getenv("MODEL"),
        messages=history,
        tools = TOOLS,
        stream=True
    )
    full_response = ""
    calls={}
    label_printed = False
    try:
        for chunk in stream:
            if(not chunk.choices):
                continue
            delta = chunk.choices[0].delta
            
            #content streaming
            if(delta.content):
                if(not label_printed):
                    print("Assistant: ", end="", flush=True)
                    label_printed = True
                print(delta.content, end="", flush=True)
                full_response += delta.content
                

            #tool call streaming
            for tc in delta.tool_calls or []:
                obj = calls.setdefault(
                    tc.index,
                    SimpleNamespace(id =None, function=SimpleNamespace(name="", arguments=""))
                )
                if(tc.id):
                    obj.id = tc.id
                if(tc.function and tc.function.name):
                    obj.function.name+= tc.function.name
                if(tc.function and tc.function.arguments):
                    obj.function.arguments+= tc.function.arguments
    except KeyboardInterrupt:
        print("\nstopped by you.")    
        calls = {}
    
    if(label_printed):
        print() #move to the next line after printing the assistant's response
        
    calls_list=[]
    for index in sorted(calls.keys()):
        calls_list.append(calls[index])
        
    return full_response, calls_list
            
    

def build_tool_calls_payload(tool_calls):
    payload=[]
    for tool_call in tool_calls:
        tool_call_dict={
            "id": tool_call.id,
            "function": {
                "name": tool_call.function.name,
                "arguments": tool_call.function.arguments
            }
        }
        payload.append(tool_call_dict)
    return payload

while True:
    user_input = input ("\nshadab : ")
    if(user_input.lower() == "exit" or user_input.lower() == "quit" or user_input.lower() == "bye"):
        break

    messages.append({"role": "user", "content": user_input})

    MAX_STEPS = 4
    #chained tool calling
    for step in range(MAX_STEPS):
        full_response,tool_calls=stream_chat(messages )
        # msg = response.choices[0].message
        if(not tool_calls):
            break
        
        log(f" step{step+1}: model requested {len(tool_calls)} tool calls")
        messages.append({"role": "assistant", "content": full_response,"tool_calls":build_tool_calls_payload(tool_calls)})
        
        for tool_call in tool_calls:
            result = run_tool(tool_call)
            messages.append({"role": "tool", "tool_id":tool_call.id,"content":str(result)})
    
    else:
        fallback = "sorry, I couldn't find a suitable answer. Please try rephrasing your question or ask something else."
        messages.append({"role": "assistant", "content": fallback})
        print(f"Assistant: {fallback}")
        continue
    
